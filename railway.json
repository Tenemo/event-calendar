{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "Dockerfile",
    "watchPatterns": [
      ".dockerignore",
      "Dockerfile",
      "pom.xml",
      "railway.json",
      "src/main/**"
    ]
  },
  "deploy": {
    "region": "europe-west4-drams3a",
    "numReplicas": 1,
    "healthcheckPath": "/health",
    "healthcheckTimeout": 300,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 3
  }
}
