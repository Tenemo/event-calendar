<server description="shared-calendar">

    <featureManager>
        <feature>webProfile-10.0</feature>
    </featureManager>

    <variable name="PORT" defaultValue="9080"/>
    <variable name="HTTPS_PORT" defaultValue="9443"/>
    <variable name="APP_LTPA_KEYS_PASSWORD" defaultValue="local-development-only"/>

    <variable name="PGHOST" defaultValue="localhost"/>
    <variable name="PGPORT" defaultValue="5432"/>
    <variable name="PGDATABASE" defaultValue="calendar"/>
    <variable name="PGUSER" defaultValue="calendar"/>
    <variable name="PGPASSWORD" defaultValue="calendar"/>

    <httpEndpoint id="defaultHttpEndpoint"
                  host="*"
                  httpPort="${PORT}"
                  httpsPort="${HTTPS_PORT}">
        <compression serverPreferredAlgorithm="gzip">
            <types>+application/*</types>
            <types>+image/svg+xml</types>
        </compression>
        <headers>
            <setIfMissing>Content-Security-Policy:frame-ancestors 'none'; base-uri 'self'; object-src 'none'</setIfMissing>
            <setIfMissing>X-Frame-Options:DENY</setIfMissing>
            <setIfMissing>X-Content-Type-Options:nosniff</setIfMissing>
            <setIfMissing>Referrer-Policy:strict-origin-when-cross-origin</setIfMissing>
            <setIfMissing>Permissions-Policy:camera=(), geolocation=(), microphone=(), payment=(), usb=()</setIfMissing>
            <setIfMissing>Strict-Transport-Security:max-age=31536000</setIfMissing>
        </headers>
    </httpEndpoint>

    <httpDispatcher trustedHeaderOrigin="100.64.*.*,100.65.*.*,100.66.*.*,100.67.*.*,100.68.*.*,100.69.*.*,100.70.*.*,100.71.*.*,100.72.*.*,100.73.*.*,100.74.*.*,100.75.*.*,100.76.*.*,100.77.*.*,100.78.*.*,100.79.*.*,100.80.*.*,100.81.*.*,100.82.*.*,100.83.*.*,100.84.*.*,100.85.*.*,100.86.*.*,100.87.*.*,100.88.*.*,100.89.*.*,100.90.*.*,100.91.*.*,100.92.*.*,100.93.*.*,100.94.*.*,100.95.*.*,100.96.*.*,100.97.*.*,100.98.*.*,100.99.*.*,100.100.*.*,100.101.*.*,100.102.*.*,100.103.*.*,100.104.*.*,100.105.*.*,100.106.*.*,100.107.*.*,100.108.*.*,100.109.*.*,100.110.*.*,100.111.*.*,100.112.*.*,100.113.*.*,100.114.*.*,100.115.*.*,100.116.*.*,100.117.*.*,100.118.*.*,100.119.*.*,100.120.*.*,100.121.*.*,100.122.*.*,100.123.*.*,100.124.*.*,100.125.*.*,100.126.*.*,100.127.*.*"/>
    <webContainer redirectToRelativeUrl="true"
                  httpsIndicatorHeader="X-Railway-Edge"/>
    <ltpa keysPassword="${APP_LTPA_KEYS_PASSWORD}"/>
    <webAppSecurity httpOnlyCookies="true"
                    sameSiteCookie="Lax"
                    ssoCookieName="LtpaToken2"
                    ssoRequiresSSL="true"
                    trackLoggedOutSSOCookies="true"/>

    <httpSession cookieHttpOnly="true"
                 cookieSecure="true"
                 cookieSameSite="Lax"
                 invalidationTimeout="30m"
                 urlRewritingEnabled="false"/>

    <library id="postgresqlDriver">
        <file name="${shared.resource.dir}/postgresql/postgresql.jar"/>
    </library>

    <dataSource id="CalendarDataSource" jndiName="jdbc/CalendarDataSource">
        <connectionManager connectionTimeout="2s"/>
        <jdbcDriver libraryRef="postgresqlDriver"/>
        <properties.postgresql serverName="${PGHOST}"
                               portNumber="${PGPORT}"
                               databaseName="${PGDATABASE}"
                               user="${PGUSER}"
                               password="${PGPASSWORD}"
                               connectTimeout="2s"
                               loginTimeout="2s"/>
    </dataSource>

    <webApplication location="shared-calendar.war"
                    contextRoot="/"/>

</server>
